                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Muted}" Text="MODS INVOLVED" />
                                <TextBlock x:Name="SelectedProvidersTextBlock" Margin="0,3,0,0" Foreground="#BAC7C5" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Muted}" Text="WHAT TO DO" />
                                <TextBlock x:Name="SelectedActionTextBlock" Margin="0,3,0,0" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SelectedHashTextBlock" Margin="0,8,0,0" FontFamily="Consolas" FontSize="10" Foreground="#657775" />
                                <Expander x:Name="TechnicalEvidenceExpander" Margin="0,8,0,0" Header="Technical details">
                                    <Grid Margin="0,5,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <DockPanel>
                                            <Button x:Name="CopyEvidenceButton" DockPanel.Dock="Right" HorizontalAlignment="Right" IsEnabled="False" Click="CopyEvidenceClicked" Content="Copy details" />
                                            <TextBlock x:Name="SelectedProofTextBlock" Margin="0,3,12,0" Foreground="#E7ECEB" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBox x:Name="ExpertEvidenceTextBox" Grid.Row="1" Margin="0,6,0,0" Height="170" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Selected technical evidence" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <StackPanel x:Name="SelectedFilesPanel" Margin="0,0,0,16" Visibility="Collapsed">
                                    <TextBlock Foreground="{StaticResource Muted}" Text="FILES INVOLVED" />
