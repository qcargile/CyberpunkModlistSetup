                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox x:Name="SelectedFilePathTextBox" Margin="0,5,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="72" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected file location" />
