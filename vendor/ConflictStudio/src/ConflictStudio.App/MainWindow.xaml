                                        <Button x:Name="OpenSourceFileButton" IsEnabled="False" Click="OpenSourceFileClicked" Content="Open file" />
                                        <Button x:Name="ShowSourceFileButton" IsEnabled="False" Margin="7,0,0,0" Click="ShowSourceFileClicked" Content="Show in folder" />
                                        <Button x:Name="CopySourcePathButton" IsEnabled="False" Margin="7,0,0,0" Click="CopySourcePathClicked" Content="Copy path" />
                                    </UniformGrid>
                                </StackPanel>
                                <TextBlock x:Name="ReviewContextTextBlock" Margin="0,0,0,9" TextWrapping="Wrap" Foreground="#D4B8FF" Visibility="Collapsed" />
                                <TextBlock Foreground="{StaticResource Muted}" Text="REVIEW OUTCOME" />
                                <ComboBox x:Name="ReviewOutcomeComboBox" Margin="0,5,0,0">
                                    <ComboBoxItem Tag="Works as intended">Works as intended</ComboBoxItem>
                                    <ComboBoxItem Tag="Compatibility patch installed">Compatibility patch installed</ComboBoxItem>
                                    <ComboBoxItem Tag="One mod intentionally owns this">I want this mod's version</ComboBoxItem>
                                    <ComboBoxItem Tag="Ignore for this profile">Ignore for this profile</ComboBoxItem>
                                </ComboBox>
                                <TextBox x:Name="ReviewRationaleTextBox" Margin="0,5,0,0" Height="54" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Optional notes" />
                                <Button x:Name="SaveOpenNoteButton" Margin="0,7,0,0" Content="Save note · keep open" IsEnabled="False" Click="SaveOpenNoteClicked" ToolTip="Save this note without accepting or hiding the finding. Empty text clears its open note." />
                                <UniformGrid Margin="0,7,0,0" Columns="2">
                                    <Button x:Name="SaveReviewButton" Click="ReviewClicked" Content="Save review" />
                                    <Button x:Name="ReopenButton" Margin="7,0,0,0" Click="ReopenClicked" Content="Reopen" />
                                </UniformGrid>
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="OPEN MOD" />
                                <ComboBox x:Name="SelectedProviderComboBox" Margin="0,5,0,0" />
                                <UniformGrid Margin="0,7,0,0" Columns="3">
                                    <Button Click="OpenCodeProviderClicked" Content="Open folder" />
                                    <Button Margin="7,0,0,0" Click="CopyActionClicked" Content="Copy next step" />
                                    <Button x:Name="ShowTechnicalEvidenceButton" Margin="7,0,0,0" Click="ShowTechnicalEvidenceClicked" Content="View evidence" />
                                </UniformGrid>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="SupportTab" Header="Support">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Support" />
                            <TextBlock x:Name="DiagnosticsSummaryTextBlock" Margin="0,3,0,0" Foreground="{StaticResource Muted}" Text="No scan has run. Reproduce a problem once, then copy the report below." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ExportButton" Margin="0,0,8,0" IsEnabled="False" Click="ExportClicked" Content="Export support bundle" ToolTip="Save the scan details and your reviews for troubleshooting." />
                            <Button Margin="8,0,0,0" Click="CopyDiagnosticReportClicked" Content="Copy report" />
                            <Button Margin="8,0,0,0" Click="SaveDiagnosticReportClicked" Content="Save report" />
                            <Button Margin="8,0,0,0" Click="OpenDiagnosticsFolderClicked" Content="Open logs folder" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,7" Background="#171F21" BorderBrush="#2A393C" BorderThickness="1">
                        <TextBlock Text="The report includes the current scan, actions you took, and recorded errors. It does not include mod source files and removes local paths." Foreground="#B7C6C4" TextWrapping="Wrap" />
                    </Border>
                    <TextBox x:Name="DiagnosticsTextBox" Grid.Row="2" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Current support report" />
                    <Expander Grid.Row="3" Margin="0,8,0,0" Header="Raw application error log">
                        <TextBox x:Name="HistoricalDiagnosticsTextBox" Margin="0,6,0,0" Height="160" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Raw application error log" />
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="Changes">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Changes between scans" />
                    <WrapPanel Grid.Row="1" Margin="0,10,0,8" VerticalAlignment="Center">
                        <TextBlock Text="Compare with" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="HistoryReferenceComboBox" Width="170" Margin="0,0,10,0" IsEnabled="False" SelectionChanged="HistoryReferenceChanged" AutomationProperties.Name="Comparison baseline">
                            <ComboBoxItem Tag="previous" IsSelected="True">Previous scan</ComboBoxItem>
                            <ComboBoxItem Tag="baseline">Pinned baseline</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="HistoryFilterComboBox" Width="180" Margin="0,0,10,0" IsEnabled="False" SelectionChanged="HistoryFilterChanged" AutomationProperties.Name="Change status">
                            <ComboBoxItem Tag="Changes" IsSelected="True">Changes only</ComboBoxItem>
                            <ComboBoxItem Tag="All">All findings</ComboBoxItem>
                            <ComboBoxItem Tag="New">New</ComboBoxItem>
                            <ComboBoxItem Tag="Changed">Changed evidence</ComboBoxItem>
                            <ComboBoxItem Tag="NoLongerDetected">No longer detected</ComboBoxItem>
                            <ComboBoxItem Tag="Unchanged">Unchanged</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="PinBaselineButton" Content="Pin current scan" IsEnabled="False" Click="PinBaselineClicked" ToolTip="Keep the current scan as your baseline. Clicking again replaces it with the current scan." />
                        <Button x:Name="ClearBaselineButton" Margin="7,0,0,0" Content="Clear baseline" IsEnabled="False" Click="ClearBaselineClicked" />
                    </WrapPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock x:Name="HistorySummaryTextBlock" Text="Run a scan to compare recorded findings." TextWrapping="Wrap" />
                        <TextBlock x:Name="BaselineStatusTextBlock" Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock x:Name="HistoryAnalysisNoticeTextBlock" Margin="0,5,0,0" Foreground="#FFD166" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Expander Header="Comparison context" Margin="0,5,0,0">
                            <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="HistoryNoticeTextBlock" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /></ScrollViewer>
                        </Expander>
                    </StackPanel>
                    <DataGrid x:Name="HistoryDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="HistorySelectionChanged" EnableRowVirtualization="True" CellStyle="{Binding CellStyle, ElementName=WorkQueueDataGrid}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#0D171C" />
                                <Setter Property="Foreground" Value="#F2F6F7" />
                                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#075A66" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger></Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding ChangeLabel}" Width="145" />
                            <DataGridTextColumn Header="Area" Binding="{Binding SurfaceLabel}" Width="160" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" MinWidth="160" />
                            <DataGridTextColumn Header="Mods involved" Binding="{Binding ProviderSummary}" Width="*" MinWidth="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="BEFORE" Foreground="{StaticResource Muted}" /><TextBox x:Name="HistoryBeforeTextBox" Height="100" Margin="0,5,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Earlier recorded evidence" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="NOW" Foreground="{StaticResource Muted}" /><TextBox x:Name="HistoryAfterTextBox" Height="100" Margin="0,5,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Current recorded evidence" /></StackPanel>
                    </Grid>
                    <DockPanel Grid.Row="5" Margin="0,10,0,0">
                        <Button x:Name="OpenHistoryFindingButton" DockPanel.Dock="Right" Content="Open current finding" IsEnabled="False" Click="OpenHistoryFindingClicked" />
                        <TextBlock Margin="0,0,15,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="No longer detected does not mean fixed. Historical rows show recorded evidence, not the current contents of old source files." />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="#0B1218" BorderBrush="#28404D" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="FooterStatusTextBlock" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="Ready" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock x:Name="ProfileBadgeTextBlock" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Text="NO PROFILE" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Margin="14,0,430,0" VerticalAlignment="Center" Foreground="#FF806A" Visibility="Collapsed" />
    </Grid>
</Window>
