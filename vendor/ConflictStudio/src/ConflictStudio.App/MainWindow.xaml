                                <Button Margin="0,7,0,0" Visibility="{Binding CanUndo, Converter={StaticResource BoolVisibility}}" Click="UndoArchiveOrderClicked" Content="Undo last applied change" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <GridSplitter x:Name="ArchivePaneSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#314346" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
                    <Grid Grid.Column="2" Margin="14,10,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Archive conflicts" />
                                <TextBlock x:Name="ArchiveConflictCountTextBlock" Margin="0,3,0,0" Foreground="{StaticResource Muted}" Text="Run a scan to inspect conflicts." />
                                <TextBlock Margin="0,3,0,0" FontSize="11"><Run Foreground="#8EA2AD" Text="Select an archive:  " /><Run Foreground="#42E58B" Text="● it wins" /><Run Foreground="#8EA2AD" Text="   " /><Run Foreground="#FF4964" Text="● it loses" /><Run Foreground="#8EA2AD" Text="   " /><Run Foreground="#00C8FF" Text="● identical" /><Run Foreground="#8EA2AD" Text="   " /><Run Foreground="#B48CFF" Text="● can't determine" /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="OpenSelectedArchiveButton" Margin="8,0,0,0" Click="OpenSelectedArchiveClicked" Content="Show archive in folder" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="ArchiveOrderEvidenceBorder" Grid.Row="1" Margin="0,9,0,9" Padding="10,7" Background="#13211D" BorderBrush="#31574D" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ArchiveOrderEvidenceTitleTextBlock" FontWeight="SemiBold" Foreground="#8EDDBF" Text="Archive order not loaded" />
                                    <TextBlock x:Name="ArchiveOrderEvidenceTextBlock" Margin="0,3,0,0" Foreground="#B7C6C4" Text="Run a profile scan." TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ArchiveOrderActionButton" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Click="FocusArchiveLoadOrderClicked" Content="Go to load order" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ShowNonConflictingFilesCheckBox" Checked="ArchiveTreeFilterChanged" Unchecked="ArchiveTreeFilterChanged" Content="Show non-conflicting files" />
                                <CheckBox x:Name="OnlyConflictingArchivesCheckBox" Margin="0,5,0,0" IsEnabled="{Binding IsChecked, ElementName=ShowNonConflictingFilesCheckBox}" Checked="ArchiveTreeFilterChanged" Unchecked="ArchiveTreeFilterChanged" Content="Only in conflicting archives" ToolTip="Show unique files only inside archives with overlaps. Same-content overlaps and unresolved conflicts are included." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,3" FontSize="10" Foreground="{StaticResource Muted}" Text="MOD OR ARCHIVE FILTER" />
                                <TextBox x:Name="ArchiveModFilterTextBox" TextChanged="ArchiveTreeFilterChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,3" FontSize="10" Foreground="{StaticResource Muted}" Text="FILE OR COMPETING ARCHIVE FILTER" />
                                <TextBox x:Name="ArchiveFileFilterTextBox" TextChanged="ArchiveTreeFilterChanged" />
                            </StackPanel>
                            <Button x:Name="ClearArchiveFiltersButton" Grid.Column="3" Margin="8,13,0,0" Click="ClearArchiveFiltersClicked" Content="Clear filters" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <TreeView x:Name="ArchiveConflictTreeView" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectedItemChanged="ArchiveConflictTreeSelectionChanged" MouseDoubleClick="ArchiveConflictTreeDoubleClicked" />
                            <Grid Grid.Column="1">
                                <local:ArchiveOverviewBar x:Name="ConflictOverviewBar" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="Selected archive relationships in conflict results" />
                                <ScrollBar x:Name="ConflictScrollBar" Style="{StaticResource OverviewScrollBar}" AutomationProperties.Name="Conflict-results scrollbar" />
                            </Grid>
                        </Grid>
                        <Border Grid.Row="4" Margin="0,9,0,0" Padding="10" Background="#0F1618" BorderBrush="#2A393C" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ArchiveSelectedTitleTextBlock" FontWeight="SemiBold" Text="Select an archive or file" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ArchiveSelectedMeaningTextBlock" Margin="0,4,0,0" Foreground="#B7C6C4" Text="Expand an archive to inspect Winning, Losing, Same content, and No conflicts inline." TextWrapping="Wrap" />
                                </StackPanel>
                                <Expander Grid.Column="1" Header="Details">
                                    <TextBlock x:Name="ArchiveSelectedTechnicalTextBlock" Margin="8,5,0,0" FontFamily="Consolas" FontSize="11" Foreground="#849694" TextWrapping="Wrap" />
                                </Expander>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Code interactions">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="90" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="3*" MinHeight="160" />
                    </Grid.RowDefinitions>
                    <Expander x:Name="CodeSummaryExpander" IsExpanded="True" Header="Code interactions · what to check">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Muted}" Text="Confirmed conflicts are changes that cannot both take effect. Items marked Review may be intentional and are not confirmed problems. Select an item to see what differs and what you can do. Identical overlaps are hidden from the default view." TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                    <Button x:Name="ColumnsButton" Content="Columns" Click="ColumnsClicked" ToolTip="Choose visible columns. Drag column dividers to resize." />
                                    <Button Margin="7,0,0,0" Content="Reset view" Click="ResetViewClicked" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Margin="0,10,0,0" Columns="4">
                                <Border Padding="10" Margin="0,0,8,0" Background="#151E20" BorderBrush="#2A393C" BorderThickness="1">
                                    <StackPanel><TextBlock Foreground="#FF4964" Text="CONFIRMED CONFLICTS" /><TextBlock x:Name="AttentionCountTextBlock" FontSize="24" Text="0" /></StackPanel>
                                </Border>
                                <Border Padding="10" Margin="0,0,8,0" Background="#151E20" BorderBrush="#2A393C" BorderThickness="1">
                                    <StackPanel><TextBlock Foreground="#FCEE0A" Text="NEEDS REVIEW" /><TextBlock x:Name="ReviewCountTextBlock" FontSize="24" Text="0" /></StackPanel>
                                </Border>
                                <Border Padding="10" Margin="0,0,8,0" Background="#151E20" BorderBrush="#2A393C" BorderThickness="1">
                                    <StackPanel><TextBlock Foreground="#B48CFF" Text="REVIEWED" /><TextBlock x:Name="ReviewedCountTextBlock" FontSize="24" Text="0" /></StackPanel>
                                </Border>
                                <Border Padding="10" Background="#151E20" BorderBrush="#2A393C" BorderThickness="1">
                                    <StackPanel><TextBlock Foreground="#42E58B" Text="IDENTICAL OVERLAPS" /><TextBlock x:Name="NoActionCountTextBlock" FontSize="24" Text="0" /></StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Expander>
                    <Grid Grid.Row="2" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QueueSearchTextBox" TextChanged="QueueFilterChanged" ToolTip="Search files, game entries, mods, or descriptions" AutomationProperties.Name="Search code conflicts" />
                        <ComboBox x:Name="QueueViewComboBox" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="QueueFilterChanged">
                            <ComboBoxItem Tag="Actionable" IsSelected="True">Conflicts and review</ComboBoxItem>
                            <ComboBoxItem Tag="Proven">Confirmed conflicts</ComboBoxItem>
                            <ComboBoxItem Tag="NeedsDecision">Needs review</ComboBoxItem>
                            <ComboBoxItem Tag="Reviewed">Reviewed</ComboBoxItem>
                            <ComboBoxItem Tag="Compatible">Identical overlaps</ComboBoxItem>
                            <ComboBoxItem Tag="All">Everything found</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="QueueSurfaceComboBox" Grid.Column="2" Margin="8,0,0,0" SelectionChanged="QueueFilterChanged">
                            <ComboBoxItem Tag="All" IsSelected="True">Everything</ComboBoxItem>
                            <ComboBoxItem Tag="VirtualFile">Code file overrides</ComboBoxItem>
                            <ComboBoxItem Tag="ScriptAndTweak">RedScript, CET, TweakXL</ComboBoxItem>
                            <ComboBoxItem Tag="SharedState">Shared values and targets</ComboBoxItem>
                            <ComboBoxItem Tag="ArchiveXl">ArchiveXL changes</ComboBoxItem>
                            <ComboBoxItem Tag="Diagnostic">Scan problems</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="QueueProviderComboBox" Grid.Column="3" Margin="8,0,0,0" SelectionChanged="QueueFilterChanged" AutomationProperties.Name="First mod" />
                        <DockPanel Grid.Column="4" Margin="8,0,0,0">
                            <TextBlock Text="With" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Muted}" />
                            <ComboBox x:Name="QueueOtherProviderComboBox" SelectionChanged="QueueFilterChanged" AutomationProperties.Name="Second mod" ToolTip="Show findings involving both selected mods. Other contributors remain included." />
                        </DockPanel>
                    </Grid>
                    <DataGrid x:Name="WorkQueueDataGrid" Grid.Row="3" CanUserResizeColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="QueueSelectionChanged">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#F2F6F7" />
                                <Setter Property="BorderBrush" Value="#2B4653" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#075A66" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="4,0,0,0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="ProvenConflict"><Setter Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.LosesBackground}" /><Setter Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.LosesBorder}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="CompetingDeclaration"><Setter Property="Background" Value="#301A0A" /><Setter Property="BorderBrush" Value="#FF9A45" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="FileOverride"><Setter Property="Background" Value="#06242A" /><Setter Property="BorderBrush" Value="#00F0FF" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="OrderSensitive"><Setter Property="Background" Value="#321701" /><Setter Property="BorderBrush" Value="#FF7A00" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="CompilerEvidence"><Setter Property="Background" Value="#241334" /><Setter Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBorder}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="RuntimeCheck"><Setter Property="Background" Value="#292600" /><Setter Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.MixedBorder}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="Composes"><Setter Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBackground}" /><Setter Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBorder}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CaseKind}" Value="SharedTarget"><Setter Property="Background" Value="#111A22" /><Setter Property="BorderBrush" Value="#728A96" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="What CS found" Width="245">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding AnalysisLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7E0DE" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="ProvenConflict"><Setter Property="Foreground" Value="#FF6A7E" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="CompetingDeclaration"><Setter Property="Foreground" Value="#FFC078" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="FileOverride"><Setter Property="Foreground" Value="#80F8FF" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="OrderSensitive"><Setter Property="Foreground" Value="#FFB15A" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="CompilerEvidence"><Setter Property="Foreground" Value="#D4B8FF" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="RuntimeCheck"><Setter Property="Foreground" Value="#FFF67A" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CaseKind}" Value="Composes"><Setter Property="Foreground" Value="#7EF0B2" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="#FFFFFF" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ReviewStatusLabel}" Foreground="#C6ACF4" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ReviewStatusLabel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Why it is here" Binding="{Binding ProofLabel}" Width="320" />
                            <DataGridTextColumn Header="Area" Binding="{Binding SurfaceLabel}" Width="150" />
                            <DataGridTemplateColumn Header="Exact target" Width="520">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Mods involved" Width="420">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProviderSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProviderSummary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Files involved" Width="320" SortMemberPath="FilesSummary">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FilesSummary}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <ToolTip>
                                                    <ScrollViewer MaxWidth="640" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding FilesDetails}" />
                                                    </ScrollViewer>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter x:Name="CodeDetailSplitter" Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#314346" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />
                    <ScrollViewer x:Name="CodeCaseDetailScrollViewer" Grid.Row="5" Margin="0,3,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="12" Background="#0F1618" BorderBrush="#2A393C" BorderThickness="1">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedClassificationTextBlock" Foreground="#FFD166" Text="Select a case" />
