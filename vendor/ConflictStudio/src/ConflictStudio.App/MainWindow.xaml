                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                                        <Button x:Name="PreviousFindingButton" Content="‹" Padding="8,6" Click="PreviousFindingClicked" IsEnabled="False" ToolTip="Previous finding in this view" AutomationProperties.Name="Previous finding" />
                                        <Button x:Name="NextFindingButton" Content="›" Margin="5,0,8,0" Padding="8,6" Click="NextFindingClicked" IsEnabled="False" ToolTip="Next finding in this view" AutomationProperties.Name="Next finding" />
                                        <Button x:Name="ViewCodeButton" Content="View code" IsEnabled="False" Click="ViewCodeClicked" ToolTip="Compare the recorded source blocks for this finding." ToolTipService.ShowOnDisabled="True" />
                                    </StackPanel>
                                    <TextBlock x:Name="SelectedTargetTextBlock" FontSize="17" FontWeight="SemiBold" Text="Select a row to see details" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Margin="0,9,0,0" FontSize="10" Foreground="{StaticResource Muted}" Text="WHAT THIS MEANS" />
                                <TextBlock x:Name="SelectedMeaningTextBlock" Margin="0,3,0,0" Foreground="#E7ECEB" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Muted}" Text="WHAT THE SOURCE SHOWS" />
                                <TextBlock x:Name="SelectedSummaryTextBlock" Margin="0,3,0,0" Foreground="#BAC7C5" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Muted}" Text="WHAT THIS DOES NOT PROVE" />
