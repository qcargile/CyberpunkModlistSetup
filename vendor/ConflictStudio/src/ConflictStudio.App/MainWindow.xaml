<Window x:Class="ConflictStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ConflictStudio.App" Title="Cyberpunk Conflict Studio" Width="1660" Height="980" MinWidth="1180" MinHeight="760" Background="#070B0F" Foreground="#F2F6F7" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0D141A" />
        <SolidColorBrush x:Key="Border" Color="#28404D" />
        <SolidColorBrush x:Key="Muted" Color="#8EA2AD" />
        <SolidColorBrush x:Key="Accent" Color="#00F0FF" />
        <SolidColorBrush x:Key="WarningAccent" Color="#FCEE0A" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#090F14" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F6F7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#111B22" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F6F7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#075A66" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#14232C" />
            <Setter Property="BorderBrush" Value="#355765" />
            <Setter Property="Foreground" Value="#F2F6F7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#0D141A" />
                    <Setter Property="Foreground" Value="#617681" />
                    <Setter Property="BorderBrush" Value="#223742" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#090F14" />
            <Setter Property="BorderBrush" Value="#35515E" />
            <Setter Property="Foreground" Value="#F2F6F7" />
            <Setter Property="CaretBrush" Value="#00F0FF" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B1218" />
            <Setter Property="Foreground" Value="#F2F6F7" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F6F7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#090F14" BorderBrush="#35515E" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <ContentPresenter Margin="0,0,20,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#00F0FF" Data="M 0 0 L 8 0 L 4 5 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Background="#0B1218" BorderBrush="#35515E" BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0D141A" />
            <Setter Property="BorderBrush" Value="#28404D" />
            <Setter Property="Foreground" Value="#F2F6F7" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AFC0BE" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="#0B1218" BorderBrush="#28404D" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#10242C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#111D24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#090F14" />
            <Setter Property="BorderBrush" Value="#28404D" />
            <Setter Property="Foreground" Value="#F2F6F7" />
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#090F14" />
            <Setter Property="BorderBrush" Value="#28404D" />
            <Setter Property="Foreground" Value="#F2F6F7" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <ControlTemplate x:Key="InvisibleScrollTrackButton" TargetType="{x:Type RepeatButton}">
            <Border Background="Transparent" />
        </ControlTemplate>
        <ControlTemplate x:Key="SlimVerticalScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid Background="#080D11">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Template="{StaticResource InvisibleScrollTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}" /></Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="18"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border Margin="2,1" Background="#A7C4CC" CornerRadius="2" Opacity="0.38" /></ControlTemplate></Thumb.Template></Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Template="{StaticResource InvisibleScrollTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="SlimHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid Background="#080D11">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Template="{StaticResource InvisibleScrollTrackButton}" Command="{x:Static ScrollBar.PageLeftCommand}" /></Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinWidth="18"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border Margin="1,2" Background="#A7C4CC" CornerRadius="2" Opacity="0.38" /></ControlTemplate></Thumb.Template></Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Template="{StaticResource InvisibleScrollTrackButton}" Command="{x:Static ScrollBar.PageRightCommand}" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#080D11" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="9" /><Setter Property="MinWidth" Value="0" /><Setter Property="MaxWidth" Value="9" /><Setter Property="Template" Value="{StaticResource SlimVerticalScrollBar}" /></Trigger>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="9" /><Setter Property="MinHeight" Value="0" /><Setter Property="MaxHeight" Value="9" /><Setter Property="Template" Value="{StaticResource SlimHorizontalScrollBar}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverviewScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource InvisibleScrollTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody" Margin="3,0" Background="#E7F7FA" CornerRadius="2" Opacity="0.18" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource InvisibleScrollTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#090F14" />
            <Setter Property="BorderBrush" Value="#28404D" />
            <Setter Property="Foreground" Value="#F2F6F7" />
            <Setter Property="RowBackground" Value="#090F14" />
            <Setter Property="AlternatingRowBackground" Value="#0C141A" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#213844" />
            <Setter Property="VerticalGridLinesBrush" Value="#344F5C" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111C24" />
            <Setter Property="Foreground" Value="#D8E6EA" />
            <Setter Property="BorderBrush" Value="#46616E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="#6A8996" />
            <Setter Property="ToolTip" Value="Drag the right edge to resize this column" />
        </Style>
        <DataTemplate DataType="{x:Type local:ArchiveRailItem}">
            <Grid>
                <Border x:Name="RelationshipRow" Padding="5,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                    <TextBlock Text="{Binding ArchiveName}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="DropBeforeLine" Height="3" VerticalAlignment="Top" Background="#FCEE0A" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="DropAfterLine" Height="3" VerticalAlignment="Bottom" Background="#FCEE0A" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Wins">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Loses">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.LosesBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.LosesBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Mixed">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.MixedBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.MixedBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Same">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.SameBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.SameBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Unknown">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DropCue}" Value="Before"><Setter TargetName="DropBeforeLine" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding DropCue}" Value="After"><Setter TargetName="DropAfterLine" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:ArchiveConflictNode}" ItemsSource="{Binding Children}">
            <Border x:Name="RelationshipRow" Margin="0,1" Padding="3,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.RowSpan="2" Foreground="#7F918F" Text="{Binding OrderPosition}" Width="38" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ArchiveName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchiveName}" />
                <StackPanel Grid.Column="2" Margin="12,0,4,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" FontSize="11" Foreground="#82928F" Text="{Binding CountSummary}" />
                    <Ellipse Width="9" Height="9" Margin="3,0" Fill="#42E58B" Visibility="{Binding HasWinning, Converter={StaticResource BoolVisibility}}" />
                    <Ellipse Width="9" Height="9" Margin="3,0" Fill="#FF304F" Visibility="{Binding HasLosing, Converter={StaticResource BoolVisibility}}" />
                    <Ellipse Width="9" Height="9" Margin="3,0" Fill="#00C8FF" Visibility="{Binding HasSame, Converter={StaticResource BoolVisibility}}" />
                    <Ellipse Width="9" Height="9" Margin="3,0" Fill="#B48CFF" Visibility="{Binding HasUnknown, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0" FontSize="11" Foreground="#82928F" Text="{Binding Provider}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Provider}" />
            </Grid>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Wins">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Loses">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.LosesBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.LosesBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Mixed">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.MixedBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.MixedBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Same">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.SameBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.SameBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelationshipTone}" Value="Unknown">
                    <Setter TargetName="RelationshipRow" Property="Background" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBackground}" />
                    <Setter TargetName="RelationshipRow" Property="BorderBrush" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBorder}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:ArchiveConflictGroupNode}" ItemsSource="{Binding Children}">
            <TextBlock Margin="3,3" FontWeight="SemiBold" Text="{Binding Header}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#AFC0BE" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="Winning">
                                <Setter Property="Foreground" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBorder}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Losing">
                                <Setter Property="Foreground" Value="#FF4964" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Same">
                                <Setter Property="Foreground" Value="{x:Static local:ArchiveRelationshipBrushes.SameBorder}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Unknown">
                                <Setter Property="Foreground" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBorder}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type local:ArchiveResourceNode}">
            <Grid Margin="3,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#AFC0BE" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Winning">
                                    <Setter Property="Foreground" Value="{x:Static local:ArchiveRelationshipBrushes.WinsBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Losing">
                                    <Setter Property="Foreground" Value="#FF4964" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Same">
                                    <Setter Property="Foreground" Value="{x:Static local:ArchiveRelationshipBrushes.SameBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Unknown">
                                    <Setter Property="Foreground" Value="{x:Static local:ArchiveRelationshipBrushes.UnknownBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Margin="16,0,4,0" Foreground="#7F918F" Text="{Binding ProviderContext}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" MinHeight="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Border Background="#0B1218" BorderBrush="#28404D" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource WarningAccent}" FontSize="20" FontWeight="Bold" Text="CONFLICT STUDIO" />
                    <Border Width="1" Height="24" Margin="15,0" Background="#46616E" />
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" Text="CYBERPUNK 2077" />
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="MOD CONFLICT CHECKER" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="18,10" Background="#0B1218" BorderBrush="#28404D" BorderThickness="0,0,0,1">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource Accent}" Text="MANAGER" />
                    <ComboBox x:Name="ManagerModeComboBox" Margin="0,4,8,0" SelectionChanged="ManagerModeChanged" AutomationProperties.Name="Mod manager">
                        <ComboBoxItem Tag="Mo2" IsSelected="True">MO2</ComboBoxItem>
                        <ComboBoxItem Tag="Vortex">Vortex</ComboBoxItem>
                        <ComboBoxItem Tag="Manual">Manual</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ManagerLocationLabel" FontSize="10" Foreground="{StaticResource Accent}" Text="MO2 INSTALLATION" />
                    <TextBox x:Name="Mo2RootTextBox" Margin="0,4,0,0" TextChanged="Mo2RootChanged" AutomationProperties.Name="Manager installation or context path" />
                </StackPanel>
                <Button x:Name="FindProfilesButton" Grid.Column="2" Margin="8,16,14,0" Click="DiscoverProfilesClicked" Content="Browse" />
                <StackPanel Grid.Column="3">
                    <TextBlock FontSize="10" Foreground="{StaticResource Accent}" Text="ACTIVE PROFILE" />
                    <ComboBox x:Name="ProfileComboBox" Margin="0,4,0,0" SelectionChanged="ProfileSelectionChanged" AutomationProperties.Name="Active profile" />
                </StackPanel>
                <Button x:Name="ScanProfileButton" Grid.Column="4" Margin="12,16,0,0" Background="#2A2900" BorderBrush="#FCEE0A" Foreground="#FFF67A" Click="UnifiedScanClicked" Content="Scan profile" />
                <Button x:Name="CancelScanButton" Grid.Column="5" Margin="8,16,0,0" IsEnabled="False" Click="CancelScanClicked" Content="Cancel" />
                <StackPanel Grid.Column="6" Margin="18,3,0,0">
                    <TextBlock x:Name="WorkspaceStatusTextBlock" Foreground="#B7C6C4" Text="Choose an installation and profile." TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ScanProgressBar" Margin="0,9,0,0" Height="4" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource Accent}" Background="#253235" />
                    <TextBlock x:Name="ScanPhaseTextBlock" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource Muted}" Text="Ready" />
                </StackPanel>
            </Grid>
            <Expander x:Name="ScanCoverageExpander" Margin="0,8,0,0" IsExpanded="False">
                <Expander.Header><TextBlock x:Name="CoverageSummaryTextBlock" Foreground="{StaticResource Muted}" Text="Run a scan to see its coverage." TextWrapping="Wrap" /></Expander.Header>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0">
                    <TextBlock x:Name="CoverageDetailsTextBlock" TextWrapping="Wrap" Foreground="#BAC7C5" />
                </ScrollViewer>
            </Expander>
            </StackPanel>
        </Border>
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="12" Background="{StaticResource Panel}" BorderBrush="#2A393C">
            <TabItem Header="Archives" IsSelected="True">
                <Grid x:Name="ArchiveOrderTabContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MinWidth="280" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="500" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12" Background="#101719" BorderBrush="#2A393C" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Load order" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="Higher archives win. Select regular archives (not REDmods) with Ctrl/Shift and drag to reorder them. Push farther into an edge to scroll faster, or use the mouse wheel while dragging. REDmods have a separate order." TextWrapping="Wrap" />
                                <Expander Margin="0,5,0,0" Header="How load order works">
                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="For regular archives, modlist.txt must list every enabled archive exactly once. The first archive listed wins when files overlap. Without this list, the game uses case-sensitive filename order (ASCII), which treats capital letters and symbols differently from ordinary alphabetical order. If entries are missing or repeated, Conflict Studio prepares a repaired list for you to review. Regular archives load before REDmods. REDmod order is shown here but must be changed through REDmod deployment." TextWrapping="Wrap" />
                                </Expander>
                            </StackPanel>
                            <TextBox x:Name="ArchiveSearchTextBox" Grid.Row="1" Margin="0,10,0,8" TextChanged="ArchiveSearchTextChanged" ToolTip="Find an archive in load order" AutomationProperties.AutomationId="ArchiveSearch" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="ArchiveOrderListBox" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionMode="Extended" SelectionChanged="ArchiveOrderSelectionChanged" />
                                <Grid Grid.Column="1">
                                    <local:ArchiveOverviewBar x:Name="LoadOrderOverviewBar" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="Selected archive relationships in load order" />
