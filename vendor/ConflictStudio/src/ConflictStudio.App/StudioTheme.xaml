<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="StudioButton" TargetType="Button">
        <Setter Property="Background" Value="#172832" />
        <Setter Property="Foreground" Value="#F2F6F7" />
        <Setter Property="BorderBrush" Value="#456573" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" />
                        <Border x:Name="StateOverlay" Background="Transparent" CornerRadius="4" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        <Border x:Name="FocusBorder" Margin="-3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateOverlay" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateOverlay" Property="Background" Value="#44000000" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="#FCEE0A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#172127" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#304049" />
                            <Setter TargetName="StateOverlay" Property="Background" Value="Transparent" />
                            <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#8A9AA2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
        <Setter Property="Background" Value="#00D7E5" />
        <Setter Property="BorderBrush" Value="#54F2FA" />
        <Setter Property="Foreground" Value="#07171C" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
        <Setter Property="Background" Value="#111D24" />
        <Setter Property="BorderBrush" Value="#344B56" />
    </Style>
    <Style x:Key="StudioTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#090F14" />
        <Setter Property="Foreground" Value="#F2F6F7" />
        <Setter Property="BorderBrush" Value="#35515E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="#00F0FF" />
        <Setter Property="SelectionBrush" Value="#075A66" />
        <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#00F0FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#172127" />
                <Setter Property="Foreground" Value="#75858D" />
                <Setter Property="BorderBrush" Value="#304049" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

