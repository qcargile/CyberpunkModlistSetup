<UserControl x:Class="ChromeBlood.Setup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource WarmBrush}"
    UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
    AutomationProperties.Name="Chrome and Blood preparation">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="PlanFieldLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
        <Style x:Key="PreparationChoice" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WarmBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="ChoiceSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="ChoiceMark" Width="18" Height="18" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" CornerRadius="2" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Path x:Name="ChoiceTick" Data="M 3,8 L 7,12 L 14,4" Stroke="{DynamicResource WarmBrush}" StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" RecognizesAccessKey="True"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceTick" Property="Visibility" Value="Visible"/><Setter TargetName="ChoiceMark" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/><Setter TargetName="ChoiceSurface" Property="Background" Value="{DynamicResource SurfaceBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ChoiceTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="ChoiceDetail" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
        <Style x:Key="CleanupStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChromeBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CleanupState}" Value="Clean"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding CleanupState}" Value="Dirty"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding CleanupState}" Value="Pending"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding CleanupState}" Value="Unsupported"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding CleanupState}" Value="Repair"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding CleanupState}" Value="Blocked"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="RequirementRow">
            <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <Button Content="Open" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ActionUrl}" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding HasActionUrl, Converter={StaticResource VisibleWhenTrue}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="StageButton" TargetType="Button" BasedOn="{StaticResource QuietLinkButton}">
            <Setter Property="Height" Value="54"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="#252027"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="#49505A" BorderThickness="1" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <Image Source="{StaticResource BrandLogoImage}" Width="25" Height="25" Margin="0,0,11,0"/>
                        <TextBlock x:Name="TitleWordmark" Text="CHROME &amp; BLOOD" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <Border x:Name="ProductLabel" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1,0,0,0" Margin="18,0,0,0" Padding="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="Cyberpunk 2077" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="−" Click="MinimizeWindow" Style="{StaticResource WindowControlButton}" AutomationProperties.Name="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="□" Click="ToggleMaximizeWindow" Style="{StaticResource WindowControlButton}" AutomationProperties.Name="Maximize or restore" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="×" Click="CloseWindow" Style="{StaticResource WindowControlButton}" AutomationProperties.Name="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#151B23" BorderBrush="#526070" BorderThickness="0,0,0,1" Padding="26,16" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding ProgressTitle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ProgressDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,8" TextWrapping="Wrap"/><ProgressBar Height="7" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" Style="{StaticResource LauncherProgressBar}" AutomationProperties.Name="Preparation progress"/></StackPanel>
                    <Button Grid.Column="1" Content="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Margin="24,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="InstallationRail" Width="202" Background="#0D0F12" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="18,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Prepare Chrome &amp; Blood" FontSize="13" Margin="4,0,0,24"/>
                            <Button Command="{Binding GameCommand}" Style="{StaticResource StageButton}" Tag="{Binding IsGamePage}"><StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="13" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasGame}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsGamePage}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CrimsonBrush}"/><Setter Property="Background" Value="{DynamicResource CrimsonBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding GameMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Text="Game" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Command="{Binding PrepareCommand}" Style="{StaticResource StageButton}" Tag="{Binding IsPreparePage}"><StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="13" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ReadyForHandoff}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsPreparePage}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CrimsonBrush}"/><Setter Property="Background" Value="{DynamicResource CrimsonBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding PrepareMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Text="Prepare" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Command="{Binding WabbajackCommand}" Style="{StaticResource StageButton}" Tag="{Binding IsWabbajackPage}"><StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="13" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsWabbajackPage}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CrimsonBrush}"/><Setter Property="Background" Value="{DynamicResource CrimsonBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Text="Wabbajack" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Installation continues&#10;in Wabbajack." FontSize="12" LineHeight="22" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="InstallationScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="40,31,40,26">
                    <StackPanel>
                        <StackPanel Visibility="{Binding ShowPageHeading, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="{Binding PageTitle}" Style="{StaticResource DisplayText}"/>
                        <TextBlock Text="{Binding PageDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,28"/></StackPanel>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SummaryGap" Width="32"/><ColumnDefinition x:Name="SummaryColumn" Width="288"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsGamePage, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="Game folder" Style="{StaticResource PlanFieldLabel}" Margin="0,0,0,8"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding GameRoot, Mode=OneWay}" AutomationProperties.Name="Cyberpunk 2077 game folder"/><Button Grid.Column="2" Content="Browse" Command="{Binding BrowseGameCommand}" Style="{StaticResource QuietButton}"/></Grid>
                                    <StackPanel Margin="0,20,0,0" Visibility="{Binding HasMultipleGames, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="More than one installation was found" Style="{StaticResource PlanFieldLabel}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding GameCandidates}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Root" AutomationProperties.Name="Choose Cyberpunk 2077 installation"/></StackPanel>
                                    <TextBlock Text="{Binding GameDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,12,0,22" TextWrapping="Wrap"/>
                                    <Button Content="Check again" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowCleanup, Converter={StaticResource VisibleWhenTrue}}">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding Foreground, ElementName=CleanupStatus}" BorderThickness="5,0,0,0" Padding="26,22">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReviewTitle}" FontFamily="{StaticResource SectionFont}" FontSize="15" Foreground="{DynamicResource ChromeBrush}" Margin="0,0,0,20" Visibility="{Binding IsReview, Converter={StaticResource VisibleWhenTrue}}"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="64" Height="64" CornerRadius="32" BorderThickness="2" BorderBrush="{Binding Foreground, ElementName=CleanupStatus}" VerticalAlignment="Top" Margin="0,5,24,0"><TextBlock Text="{Binding CleanupSymbol}" FontFamily="Segoe UI Symbol" FontSize="35" Style="{StaticResource CleanupStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="CleanupStatus" Text="{Binding CleanupTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold" TextWrapping="Wrap" Style="{StaticResource CleanupStatusText}" AutomationProperties.LiveSetting="Polite"/>
                                                    <TextBlock Text="{Binding CleanupDetail}" FontSize="15" Foreground="{DynamicResource ChromeBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                    <TextBlock Text="{Binding CleanupFailure}" FontSize="13" Foreground="{DynamicResource ChromeBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasCleanupFailure, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.LiveSetting="Polite"/>
                                                    <TextBlock Text="Removed files are backed up. Saves are kept." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="Back up changed files before repair" Command="{Binding ReviewCleanupCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="88,20,0,0" Visibility="{Binding ShowOfficialBackupAction, Converter={StaticResource VisibleWhenTrue}}"/>
                                            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Expander x:Name="CleanupDetails" Header="Details and backups" Foreground="{DynamicResource ChromeBrush}"/>
                                            <Button Grid.Column="1" Content="{Binding SecondaryContinueText}" Command="{Binding ContinueWithoutCleanupCommand}" Style="{StaticResource QuietLinkButton}" BorderThickness="0" MinHeight="24" Padding="8,0" Margin="16,0,0,0" VerticalAlignment="Top" Visibility="{Binding ShowSecondaryContinue, Converter={StaticResource VisibleWhenTrue}}"/>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsExpanded, ElementName=CleanupDetails, Converter={StaticResource VisibleWhenTrue}}">
                                                <StackPanel Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding CleanupReferenceDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding GameFileCheckDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    <TextBlock Text="{Binding BackupSizeDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasPlannedBackup, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Backup locations" Style="{StaticResource PlanFieldLabel}"/><TextBlock Text="{Binding PlannedBackupRoot}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasBackup, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Saved backup" Style="{StaticResource PlanFieldLabel}"/><TextBlock Text="{Binding BackupRoot}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8"/><Button Content="Open backup folder" Command="{Binding OpenBackupCommand}" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left"/></StackPanel>
                                                    <TextBlock Text="{Binding RecoveryDetail}" Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasRecoveryDetail, Converter={StaticResource VisibleWhenTrue}}"/>
                                                    <ListBox ItemsSource="{Binding CleanupItems}" MaxHeight="280" Background="Transparent" BorderThickness="0" Margin="0,14,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource WarmBrush}"/></Style></ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><TextBlock Text="{Binding Path}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Text="Saved Games and MO2/download folders outside this game folder are untouched. Extra files inside it can move to backup. Changed official files are copied to backup and left for store repair." Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <WrapPanel><Button Content="Verify game files" Command="{Binding CheckGameFilesCommand}" Style="{StaticResource QuietLinkButton}" Margin="0,0,20,0"/><Button Content="Review cleanup" Command="{Binding ReviewCleanupCommand}" Style="{StaticResource QuietLinkButton}"/></WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="0,20,0,0" Visibility="{Binding IsReview, Converter={StaticResource VisibleWhenTrue}}">
                                        <TextBlock Text="{Binding ReviewReminder}" FontSize="13" Foreground="{DynamicResource ChromeBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Margin="0,20,0,0" Visibility="{Binding HasAdditionalActions, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Text="Selected preparation" FontFamily="{StaticResource SectionFont}" FontSize="18" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding ReviewedPreparationActions}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,24,0,0" Visibility="{Binding ShowChecklist, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding IsIdle}">
                                        <StackPanel Margin="0,0,0,24" Visibility="{Binding HasManualChecks, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Text="Needs your attention" FontFamily="{StaticResource SectionFont}" FontSize="18" Foreground="{DynamicResource WarningBrush}"/>
                                            <ItemsControl ItemsSource="{Binding ManualChecks}" ItemTemplate="{StaticResource RequirementRow}"/>
                                            <Button Content="Choose Wabbajack app folder" Command="{Binding BrowseWabbajackCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding NeedsWabbajackFolder, Converter={StaticResource VisibleWhenTrue}}"/>
                                        </StackPanel>
                                        <Grid x:Name="PreparationChoices"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ChoicesGap" Width="32"/><ColumnDefinition x:Name="OptionalColumn" Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Needed for installation" FontFamily="{StaticResource SectionFont}" FontSize="20"/>
                                                <TextBlock Text="Missing components are selected for you." Style="{StaticResource ChoiceDetail}" Margin="0,6,0,10" Visibility="{Binding HasAutomaticPreparation, Converter={StaticResource VisibleWhenTrue}}"/>
                                                <CheckBox IsChecked="{Binding InstallRuntimes}" Style="{StaticResource PreparationChoice}" Visibility="{Binding NeedsRuntimes, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Install missing Visual C++ runtimes"><StackPanel><TextBlock Text="Visual C++ runtimes" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Install the Microsoft components used by the game and MO2." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                                <CheckBox IsChecked="{Binding EnableLongPaths}" Style="{StaticResource PreparationChoice}" Visibility="{Binding NeedsLongPaths, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Enable Windows long paths"><StackPanel><TextBlock Text="Windows long paths" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Allow the longer file paths used by the modlist." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                                <CheckBox IsChecked="{Binding DownloadWabbajack}" Style="{StaticResource PreparationChoice}" Visibility="{Binding NeedsWabbajack, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Download Wabbajack"><StackPanel><TextBlock Text="Wabbajack" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Download the official app to install Chrome &amp; Blood." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                                <TextBlock Text="✓  Required components are ready" Foreground="{DynamicResource SuccessBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,8" Visibility="{Binding AutomaticPreparationReady, Converter={StaticResource VisibleWhenTrue}}"/>
                                            </StackPanel>
                                            <StackPanel x:Name="OptionalChoices" Grid.Column="2">
                                                <TextBlock Text="Optional" FontFamily="{StaticResource SectionFont}" FontSize="20"/>
                                                <TextBlock Text="Leave these off unless you want them." Style="{StaticResource ChoiceDetail}" Margin="0,6,0,10"/>
                                                <CheckBox IsChecked="{Binding ResetSettings}" IsEnabled="{Binding CanChooseFreshCleanup}" Style="{StaticResource PreparationChoice}" AutomationProperties.Name="Reset Cyberpunk settings"><StackPanel><TextBlock Text="Reset Cyberpunk settings" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Back up and reset game and mod preferences. Keeps saves." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                                <CheckBox IsChecked="{Binding SteamLaunchOnly}" Style="{StaticResource PreparationChoice}" Visibility="{Binding ShowSteamChoice, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Update only when launched from Steam"><StackPanel><TextBlock Text="Update only on Steam launch" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Close Steam first. This does not lock the game version." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                                <CheckBox IsChecked="{Binding LegacyDirectX}" Style="{StaticResource PreparationChoice}" Visibility="{Binding ShowDirectXChoice, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Install legacy DirectX components"><StackPanel><TextBlock Text="Legacy DirectX components" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Older Microsoft libraries for tools that need them." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                                <CheckBox IsChecked="{Binding ClearDiagnostics}" IsEnabled="{Binding CanChooseFreshCleanup}" Style="{StaticResource PreparationChoice}" AutomationProperties.Name="Clear shared crash reports"><StackPanel><TextBlock Text="Clear shared crash reports" Style="{StaticResource ChoiceTitle}"/><TextBlock Text="Back up and clear diagnostics, including other REDengine games." Style="{StaticResource ChoiceDetail}"/></StackPanel></CheckBox>
                                            </StackPanel>
                                        </Grid>
                                        <Expander Header="{Binding ReadyChecksTitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0" Visibility="{Binding HasReadyChecks, Converter={StaticResource VisibleWhenTrue}}"><ItemsControl ItemsSource="{Binding ReadyChecks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                                        <Expander Header="Wabbajack app location" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding WabbajackDirectory}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><Button Content="Change app folder" Command="{Binding BrowseWabbajackCommand}" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel></Expander>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsWabbajackPage, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="Continue in Wabbajack" FontWeight="SemiBold"/>
                                    <TextBlock Text="Open the Chrome &amp; Blood listing, sign in to Nexus, then choose your installation and download folders there." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,24" TextWrapping="Wrap"/>
                                    <Border Style="{StaticResource PanelBorder}" Padding="20"><StackPanel><TextBlock Text="Chrome &amp; Blood" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"/><TextBlock Text="Cyberpunk 2077" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,16"/><TextBlock Text="{Binding HandoffDetail}" Foreground="{DynamicResource ChromeBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="PreparationSummary" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" Padding="24" MinHeight="398" VerticalAlignment="Top"><StackPanel>
                                <TextBlock Text="Chrome &amp; Blood" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SummaryStatus}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="36" TextWrapping="Wrap" Margin="0,14,0,20"/>
                                <TextBlock Text="Game installation" Style="{StaticResource PlanFieldLabel}"/><TextBlock Text="{Binding GameRoot}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18"/>
                                <TextBlock Text="Wabbajack app" Style="{StaticResource PlanFieldLabel}"/><TextBlock Text="{Binding WabbajackDirectory}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                <Button Content="Change app folder" Command="{Binding BrowseWabbajackCommand}" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                                <TextBlock Text="Installation and download folders are selected in Wabbajack." Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                <Expander Header="Backup details" Foreground="{DynamicResource ChromeBrush}" Margin="0,20,0,0" Visibility="{Binding HasBackup, Converter={StaticResource VisibleWhenTrue}}"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding BackupRoot}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="Open backup folder" Command="{Binding OpenBackupCommand}" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
                            </StackPanel></Border>
                        </Grid>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ChromeBrush}" TextWrapping="Wrap" Margin="0,24,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CanvasBrush}" Padding="26,18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="{Binding BackText}" Command="{Binding BackCommand}" Visibility="{Binding ShowBack, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource QuietLinkButton}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Style="{StaticResource DominantButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

