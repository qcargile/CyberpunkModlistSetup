<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentation="clr-namespace:ChromeBlood.Presentation">
    <SolidColorBrush x:Key="VoidBrush" Color="#0A0B0D" />
    <SolidColorBrush x:Key="CarbonBrush" Color="#101216" />
    <SolidColorBrush x:Key="PanelBrush" Color="#181C22" />
    <SolidColorBrush x:Key="CrimsonBrush" Color="#FF2E44" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#C9D7F0" />
    <SolidColorBrush x:Key="WarmBrush" Color="#E7E8E2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AEB7C4" />
    <SolidColorBrush x:Key="RuleBrush" Color="#343B46" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#657080" />
    <SolidColorBrush x:Key="LauncherScrollTrackBrush" Color="#101216" />
    <SolidColorBrush x:Key="FocusBrush" Color="#C9D7F0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7ED5AC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B13D" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7582" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2E44" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0A0B0D" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#0A0B0D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#101216" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#181C22" />
    <SolidColorBrush x:Key="BodyBrush" Color="#E7E8E2" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB7C4" />
    <FontFamily x:Key="DisplayFont">/ChromeBlood.Presentation;component/Assets/#Rajdhani</FontFamily>
    <FontFamily x:Key="SectionFont">/ChromeBlood.Presentation;component/Assets/#Chakra Petch</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <Style x:Key="LauncherScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LauncherScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ChromeBrush}" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource CrimsonBrush}" /></Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" /></DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LauncherVerticalScrollThumb" TargetType="Thumb" BasedOn="{StaticResource LauncherScrollThumb}"><Setter Property="MinHeight" Value="28" /></Style>
    <Style x:Key="LauncherHorizontalScrollThumb" TargetType="Thumb" BasedOn="{StaticResource LauncherScrollThumb}"><Setter Property="MinWidth" Value="28" /></Style>
    <ControlTemplate x:Key="LauncherVerticalScrollBar" TargetType="ScrollBar">
        <Border x:Name="TrackSurface" Background="{DynamicResource LauncherScrollTrackBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1,0,0,0" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource LauncherScrollPageButton}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource LauncherVerticalScrollThumb}" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource LauncherScrollPageButton}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
            </Track>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TrackSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TrackSurface" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="LauncherHorizontalScrollBar" TargetType="ScrollBar">
        <Border x:Name="TrackSurface" Background="{DynamicResource LauncherScrollTrackBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource LauncherScrollPageButton}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource LauncherHorizontalScrollThumb}" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource LauncherScrollPageButton}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
            </Track>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TrackSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TrackSurface" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="Background" Value="{DynamicResource LauncherScrollTrackBrush}" />
        <Setter Property="Template" Value="{StaticResource LauncherVerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template" Value="{StaticResource LauncherHorizontalScrollBar}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Geometry x:Key="BrandMark">M 4,2 L 28,2 28,22 20,30 4,30 Z</Geometry>
    <Geometry x:Key="BrandSlash">M 22,2 L 8,30 4,30 4,2 Z</Geometry>
    <DrawingImage x:Key="BrandLogoImage"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L32,0 32,32 0,32 Z" /><GeometryDrawing Brush="#C9D7F0" Geometry="{StaticResource BrandMark}" /><GeometryDrawing Brush="#FF2E44" Geometry="{StaticResource BrandSlash}" /></DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <BitmapImage x:Key="LandscapeImage" UriSource="pack://application:,,,/ChromeBlood.Presentation;component/Assets/landscape.jpg" />
    <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/ChromeBlood.Presentation;component/Assets/app-icon.png" />
    <Style x:Key="LauncherProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="#303842" />
        <Setter Property="Foreground" Value="{DynamicResource CrimsonBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Determinate" />
                                <VisualState x:Name="Indeterminate">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BusyPattern" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="BusyPattern" Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)" From="0" To="16" Duration="0:0:0.7" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        <Rectangle x:Name="BusyPattern" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,7" ViewportUnits="Absolute">
                                    <DrawingBrush.Transform><TranslateTransform /></DrawingBrush.Transform>
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#39414E" Geometry="M0,0 H16 V7 H0 Z" />
                                            <GeometryDrawing Brush="#697588" Geometry="M0,7 L5,0 12,0 7,7 Z" />
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <presentation:CutCornerGeometryConverter x:Key="CutCornerGeometryConverter" />
    <ControlTemplate x:Key="CutCornerButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Border.Clip><MultiBinding Converter="{StaticResource CutCornerGeometryConverter}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" /></MultiBinding></Border.Clip>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.92" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.92" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleText}" />
    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SectionFont}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource HeadingText}" />
    <Style x:Key="SubsectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SectionFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SurfacePanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CompactButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.92" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource CutCornerButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" /></Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" /><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" /><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="QuietActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
    </Style>
    <Style x:Key="QuietLinkButton" TargetType="Button" BasedOn="{StaticResource QuietActionButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeBrush}" />
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource QuietActionButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style x:Key="PlayerTabButton" TargetType="Button" BasedOn="{StaticResource QuietLinkButton}">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,6,8,6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource BodyBrush}" /></DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
        </Style.Triggers>
    </Style>
        <Style x:Key="DisclosureExpander" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Padding="0,16">
                        <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="12,10" Cursor="Hand" Foreground="{DynamicResource ChromeBrush}" HorizontalContentAlignment="Left" AutomationProperties.Name="{TemplateBinding Header}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="ClosedArrow" Data="M 0,0 L 0,9 L 7,4.5 Z" Fill="{DynamicResource ChromeBrush}" Width="7" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Path x:Name="OpenArrow" Data="M 0,0 L 10,0 L 5,7 Z" Fill="{DynamicResource ChromeBrush}" Width="10" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ClosedArrow" Property="Visibility" Value="Collapsed"/><Setter TargetName="OpenArrow" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                    </Border>
                    <ContentPresenter x:Name="FaqContent" Grid.Row="1" ContentSource="Content" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="FaqContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
</ResourceDictionary>
